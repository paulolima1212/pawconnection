# Desenvolvimento local (padrão recomendado no Expo Go)
EXPO_PUBLIC_USE_LAN_API=true
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_APP_URL=https://paw-app.lz-plima1212.online
EXPO_PUBLIC_SUPABASE_URL=https://supabase.lz-plima1212.online
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=paw-media

# Produção / APK remoto (builds EAS — use eas.json ou comente USE_LAN_API):
# EXPO_PUBLIC_USE_REMOTE_API=true
# EXPO_PUBLIC_API_URL=https://paw-backend.lz-plima1212.online

# O app em __DEV__ resolve http://<IP-do-Metro>:3001 quando USE_LAN_API=true.
# Emulador Android: localhost vira 10.0.2.2 automaticamente.

# Google Maps (obrigatório para mapa no APK / build nativo Android)
# Crie em https://console.cloud.google.com/ → Maps SDK for Android
# Restrinja por package: online.lzplima1212.pawconnection
# SHA-1 (debug keystore local): 5E:8F:16:06:2E:A3:CD:2C:4A:0D:54:78:76:BA:A6:F3:8C:AB:F6:25
GOOGLE_MAPS_ANDROID_API_KEY=
