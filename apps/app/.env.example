# Desenvolvimento local (padrão recomendado no Expo Go)
# USE_LAN_API=true faz o app conectar no IP da máquina de dev quando rodando via Expo Go
EXPO_PUBLIC_USE_LAN_API=true
EXPO_PUBLIC_API_URL=http://localhost:3001

# URL pública do app (usada para deep links e OAuth callbacks)
EXPO_PUBLIC_APP_URL=http://localhost:8081

# Supabase (self-hosted local ou cloud)
# Local: http://localhost:8000 (se usar docker-compose com Supabase)
# Cloud: https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=paw-media

# Produção / APK remoto (builds EAS — use eas.json ou comente USE_LAN_API):
# EXPO_PUBLIC_USE_REMOTE_API=true
# EXPO_PUBLIC_API_URL=https://sua-api-producao.com

# Porta da API quando rodando localmente via LAN (padrão: 3001)
# EXPO_PUBLIC_LAN_API_PORT=3001

# Emulador Android: localhost é convertido automaticamente para 10.0.2.2

# Google Maps (obrigatório para mapa no APK / build nativo Android)
# Crie uma chave em https://console.cloud.google.com/ → APIs & Services → Credentials
# Habilite: Maps SDK for Android
# Restrinja a chave ao package name do app: com.plima1212.pawconnection (ou seu package)
# SHA-1 da debug keystore local: 5E:8F:16:06:2E:A3:CD:2C:4A:0D:54:78:76:BA:A6:F3:8C:AB:F6:25
GOOGLE_MAPS_ANDROID_API_KEY=
