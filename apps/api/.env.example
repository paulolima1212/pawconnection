# Banco de dados PostgreSQL
# Use docker-compose: postgresql://postgres:paw@localhost:5432/paw_connection?schema=public
# Ou Supabase local: postgresql://postgres.your-tenant-id:YOUR_PASSWORD@localhost:54321/postgres?schema=public
DATABASE_URL="postgresql://postgres:paw@localhost:5432/paw_connection?schema=public"

# JWT para autenticação (MUDE EM PRODUÇÃO!)
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Porta da API
PORT=3001

# URLs públicas (produção)
# Em desenvolvimento local, use http://localhost:3001 (ou IP da sua rede se testar de dispositivos remotos)
PUBLIC_API_URL="http://localhost:3001"
APP_URL="http://localhost:8081"

# CORS: origens permitidas (separadas por vírgula, ou deixe vazio para aceitar localhost/LAN em dev)
# Produção: defina domínios específicos; dev: pode deixar vazio ou listar portas Metro/Expo
CORS_ORIGINS=""

# Supabase (self-hosted ou cloud)
# Local (docker-compose com Supabase): http://localhost:8000
# Cloud: https://seu-projeto.supabase.co
SUPABASE_URL="http://localhost:8000"

# URL pública do Supabase para links de storage (em produção, deve ser acessível do app)
# Se SUPABASE_URL for interno (localhost), defina uma URL pública aqui
SUPABASE_PUBLIC_URL="http://localhost:8000"

# Chaves do Supabase (obtenha em Project Settings > API)
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_KEY="your-service-role-key"

# Bucket de armazenamento de mídia no Supabase Storage
SUPABASE_STORAGE_BUCKET="paw-media"

# Password reset and report emails (optional — logs to console when RESEND_API_KEY is unset).
# To email arbitrary users, verify the sending domain at https://resend.com/domains
# and set EMAIL_FROM to an address on that domain. onboarding@resend.dev can only
# deliver to the Resend account owner.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Paw Connection <noreply@your-domain.com>"
# Developer inbox for publication reports (required to email reported content)
# REPORTS_INBOX_EMAIL="developer@your-domain.com"

# Google Places Nearby (New) — server key with Places API (New) enabled.
# Do not reuse an Android-restricted Maps SDK key. Leave unset to skip place pins.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=
